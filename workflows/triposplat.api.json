{
  "image": { "class_type": "LoadImage", "inputs": { "image": "canonical.png" }, "_meta": { "title": "Canonical character" } },
  "bg_model": { "class_type": "LoadBackgroundRemovalModel", "inputs": { "bg_removal_name": "birefnet.safetensors" } },
  "bg_mask": { "class_type": "RemoveBackground", "inputs": { "bg_removal_model": ["bg_model", 0], "image": ["image", 0] }, "_meta": { "title": "Remove background (BiRefNet)" } },
  "prepare": { "class_type": "TripoSplatPreprocessImage", "inputs": { "image": ["image", 0], "mask": ["bg_mask", 0], "erode_radius": 1, "size": 1024 } },
  "dino": { "class_type": "CLIPVisionLoader", "inputs": { "clip_name": "dino_v3_vit_h.safetensors" } },
  "flux_vae": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "splat_vae": { "class_type": "VAELoader", "inputs": { "vae_name": "triposplat_vae_decoder_fp16.safetensors" } },
  "unet": { "class_type": "UNETLoader", "inputs": { "unet_name": "triposplat_fp16.safetensors", "weight_dtype": "default" } },
  "condition": { "class_type": "TripoSplatConditioning", "inputs": { "clip_vision": ["dino", 0], "vae": ["flux_vae", 0], "image": ["prepare", 0] } },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["unet", 0], "seed": 46, "steps": 20, "cfg": 3, "sampler_name": "dpmpp_2m", "scheduler": "simple",
      "positive": ["condition", 0], "negative": ["condition", 1], "latent_image": ["condition", 2], "denoise": 1
    }
  },
  "decode": { "class_type": "VAEDecodeTripoSplat", "inputs": { "samples": ["sampler", 0], "vae": ["splat_vae", 0], "num_gaussians": 262144, "seed": 46 } },
  "to_spz": { "class_type": "SplatToFile3D", "inputs": { "splat": ["decode", 0], "format": "spz" } },
  "save_spz": { "class_type": "SaveGLB", "inputs": { "mesh": ["to_spz", 0], "filename_prefix": "character-forge/splat" }, "_meta": { "title": "Save splat (SPZ)" } },
  "to_ply": { "class_type": "SplatToFile3D", "inputs": { "splat": ["decode", 0], "format": "ply" } },
  "save_ply": { "class_type": "SaveGLB", "inputs": { "mesh": ["to_ply", 0], "filename_prefix": "character-forge/splat" }, "_meta": { "title": "Save splat (PLY)" } },
  "camera": {
    "class_type": "CreateCameraInfo",
    "inputs": {
      "mode": "orbit", "mode.yaw": 90, "mode.pitch": 6, "mode.distance": 1.6,
      "target_x": 0, "target_y": 0, "target_z": 0, "roll": 0, "fov": 35, "zoom": 1, "camera_type": "perspective"
    }
  },
  "render": {
    "class_type": "RenderSplat",
    "inputs": {
      "splat": ["decode", 0], "camera_info": ["camera", 0], "width": 720, "height": 960, "frames": 96,
      "splat_scale": 1, "sharpen": 2, "headlight_shading": 0, "opacity_threshold": 0, "render_style": "color", "background": "#0b0d14"
    }
  },
  "video": { "class_type": "CreateVideo", "inputs": { "images": ["render", 0], "fps": 24 } },
  "save_orbit": { "class_type": "SaveVideo", "inputs": { "video": ["video", 0], "filename_prefix": "character-forge/orbit", "format": "auto", "format.codec": "auto" }, "_meta": { "title": "Save orbit video" } }
}
