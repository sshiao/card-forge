{
  "image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "canonical.png"
    }
  },
  "bg_model": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "bg_mask": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "bg_model",
        0
      ],
      "image": [
        "image",
        0
      ]
    }
  },
  "crop": {
    "class_type": "ImageCropToMask",
    "inputs": {
      "images": [
        "image",
        0
      ],
      "masks": [
        "bg_mask",
        0
      ],
      "width": 1024,
      "height": 1024,
      "pad_factor": 1.0,
      "grow_mask": 0,
      "background": "#000000"
    }
  },
  "dino": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "dino_v3_L_naf_fp32.safetensors"
    }
  },
  "condition": {
    "class_type": "Trellis2Conditioning",
    "inputs": {
      "clip_vision_model": [
        "dino",
        0
      ],
      "image": [
        "crop",
        0
      ]
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "trellis_2_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "shape_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "trellis_2_shape_vae_bf16.safetensors"
    }
  },
  "texture_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "trellis_2_texture_vae_bf16.safetensors"
    }
  },
  "empty": {
    "class_type": "EmptyTrellis2LatentStructure",
    "inputs": {
      "batch_size": 1
    }
  },
  "structure_cfg": {
    "class_type": "CFGOverride",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "cfg": 1,
      "start_percent": 0.667,
      "end_percent": 1
    }
  },
  "structure_rescale": {
    "class_type": "RescaleCFG",
    "inputs": {
      "model": [
        "structure_cfg",
        0
      ],
      "multiplier": 0.7
    }
  },
  "structure_shift": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "structure_rescale",
        0
      ],
      "shift": 5
    }
  },
  "structure_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "structure_shift",
        0
      ],
      "positive": [
        "condition",
        0
      ],
      "negative": [
        "condition",
        1
      ],
      "latent_image": [
        "empty",
        0
      ],
      "seed": 42,
      "steps": 12,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    }
  },
  "structure_decode": {
    "class_type": "VaeDecodeStructureTrellis2",
    "inputs": {
      "samples": [
        "structure_sampler",
        0
      ],
      "vae": [
        "shape_vae",
        0
      ],
      "resolution": "32"
    }
  },
  "shape_stage": {
    "class_type": "Trellis2ShapeStage",
    "inputs": {
      "positive": [
        "condition",
        0
      ],
      "negative": [
        "condition",
        1
      ],
      "voxel": [
        "structure_decode",
        0
      ]
    }
  },
  "shape_cfg": {
    "class_type": "CFGOverride",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "cfg": 1,
      "start_percent": 0.769,
      "end_percent": 1
    }
  },
  "shape_rescale": {
    "class_type": "RescaleCFG",
    "inputs": {
      "model": [
        "shape_cfg",
        0
      ],
      "multiplier": 0.5
    }
  },
  "shape_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "shape_rescale",
        0
      ],
      "positive": [
        "shape_stage",
        0
      ],
      "negative": [
        "shape_stage",
        1
      ],
      "latent_image": [
        "shape_stage",
        2
      ],
      "seed": 42,
      "steps": 20,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    }
  },
  "upsample_stage": {
    "class_type": "Trellis2UpsampleStage",
    "inputs": {
      "positive": [
        "shape_stage",
        0
      ],
      "negative": [
        "shape_stage",
        1
      ],
      "shape_latent": [
        "shape_sampler",
        0
      ],
      "vae": [
        "shape_vae",
        0
      ],
      "target_resolution": 1536
    }
  },
  "upsample_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "shape_rescale",
        0
      ],
      "positive": [
        "upsample_stage",
        0
      ],
      "negative": [
        "upsample_stage",
        1
      ],
      "latent_image": [
        "upsample_stage",
        2
      ],
      "seed": 42,
      "steps": 12,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "shape_decode": {
    "class_type": "VaeDecodeShapeTrellis",
    "inputs": {
      "samples": [
        "upsample_sampler",
        0
      ],
      "vae": [
        "shape_vae",
        0
      ]
    }
  },
  "texture_stage": {
    "class_type": "Trellis2TextureStage",
    "inputs": {
      "positive": [
        "upsample_stage",
        0
      ],
      "negative": [
        "upsample_stage",
        1
      ],
      "shape_latent": [
        "upsample_sampler",
        0
      ]
    }
  },
  "texture_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "positive": [
        "texture_stage",
        0
      ],
      "negative": [
        "texture_stage",
        1
      ],
      "latent_image": [
        "texture_stage",
        2
      ],
      "seed": 43,
      "steps": 12,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    }
  },
  "texture_decode": {
    "class_type": "VaeDecodeTextureTrellis",
    "inputs": {
      "samples": [
        "texture_sampler",
        0
      ],
      "vae": [
        "texture_vae",
        0
      ],
      "shape_subdivides": [
        "shape_decode",
        1
      ]
    }
  },
  "remesh": {
    "class_type": "RemeshMesh",
    "inputs": {
      "mesh": [
        "shape_decode",
        0
      ],
      "resolution": 1024,
      "sign_mode": "udf",
      "sign_mode.qef": false,
      "sign_mode.drop_inverted_components": false,
      "sign_mode.drop_enclosed_components": false,
      "band": 1,
      "project_back": 0,
      "fix_poles": false,
      "smooth_iters": 0,
      "drop_small_components": 0,
      "precluster_max_verts": 20000000
    }
  },
  "decimate": {
    "class_type": "DecimateMesh",
    "inputs": {
      "mesh": [
        "remesh",
        0
      ],
      "target_face_count": 1000000,
      "placement_mode": "midpoint"
    }
  },
  "smooth": {
    "class_type": "MeshSmoothNormals",
    "inputs": {
      "mesh": [
        "decimate",
        0
      ],
      "crease_angle": 180
    }
  },
  "unwrap": {
    "class_type": "UnwrapMesh",
    "inputs": {
      "mesh": [
        "smooth",
        0
      ],
      "segmenter": "pec",
      "resolution": 4096,
      "padding": 2,
      "weld_distance": 0.0002
    }
  },
  "bake": {
    "class_type": "BakeTextureFromVoxel",
    "inputs": {
      "mesh": [
        "unwrap",
        0
      ],
      "voxel_colors": [
        "texture_decode",
        0
      ],
      "reference_mesh": [
        "shape_decode",
        0
      ],
      "texture_size": 4096
    }
  },
  "normal": {
    "class_type": "BakeNormalMapFromMesh",
    "inputs": {
      "low_poly": [
        "unwrap",
        0
      ],
      "high_poly": [
        "shape_decode",
        0
      ],
      "resolution": 4096,
      "cage_distance": 0.05,
      "ignore_backfaces": true
    }
  },
  "ao": {
    "class_type": "BakeAmbientOcclusion",
    "inputs": {
      "low_poly": [
        "unwrap",
        0
      ],
      "high_poly": [
        "remesh",
        0
      ],
      "resolution": 1024,
      "samples": 64,
      "max_distance": 0.71,
      "strength": 1,
      "bias": 0.01
    }
  },
  "material": {
    "class_type": "ApplyTextureToMesh",
    "inputs": {
      "mesh": [
        "unwrap",
        0
      ],
      "base_color": [
        "bake",
        0
      ],
      "metallic": [
        "bake",
        1
      ],
      "roughness": [
        "bake",
        2
      ],
      "normal_map": [
        "normal",
        0
      ],
      "occlusion": [
        "ao",
        0
      ]
    }
  },
  "to_glb": {
    "class_type": "MeshToFile3D",
    "inputs": {
      "mesh": [
        "material",
        0
      ]
    }
  },
  "mesh": {
    "class_type": "SaveGLB",
    "inputs": {
      "mesh": [
        "to_glb",
        0
      ],
      "filename_prefix": "character-forge/trellis2"
    }
  }
}
