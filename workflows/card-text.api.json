{
  "photo": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "photo.jpg"
    },
    "_meta": {
      "title": "Photo"
    }
  },
  "vlm": {
    "class_type": "AILab_QwenVL_Advanced",
    "inputs": {
      "model_name": "Qwen3-VL-8B-Instruct",
      "quantization": "None (FP16)",
      "attention_mode": "auto",
      "use_torch_compile": false,
      "device": "auto",
      "preset_prompt": "🖼️ Detailed Description",
      "custom_prompt": "",
      "max_tokens": 900,
      "temperature": 0.9,
      "top_p": 0.95,
      "num_beams": 1,
      "repetition_penalty": 1.1,
      "frame_count": 16,
      "keep_model_loaded": false,
      "seed": 1,
      "image": [
        "photo",
        0
      ]
    },
    "_meta": {
      "title": "Card text prompt"
    }
  },
  "save": {
    "class_type": "SaveText",
    "inputs": {
      "text": [
        "vlm",
        0
      ],
      "filename_prefix": "card-forge/card-text",
      "format": "json"
    }
  }
}
