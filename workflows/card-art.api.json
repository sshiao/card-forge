{
  "photo": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "photo.jpg"
    },
    "_meta": {
      "title": "Photo"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_edit_2511_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "shift": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "shift": 3.1
    }
  },
  "cfg_norm": {
    "class_type": "CFGNorm",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "strength": 1
    }
  },
  "lightning": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "cfg_norm",
        0
      ],
      "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1
    }
  },
  "scaled": {
    "class_type": "FluxKontextImageScale",
    "inputs": {
      "image": [
        "photo",
        0
      ]
    }
  },
  "positive_text": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "image1": [
        "scaled",
        0
      ],
      "prompt": ""
    },
    "_meta": {
      "title": "Art prompt"
    }
  },
  "negative_text": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "image1": [
        "scaled",
        0
      ],
      "prompt": ""
    }
  },
  "positive": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": [
        "positive_text",
        0
      ],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "negative": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": [
        "negative_text",
        0
      ],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1184,
      "height": 880,
      "batch_size": 2
    },
    "_meta": {
      "title": "Art size, set by the card layout"
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "lightning",
        0
      ],
      "seed": 1,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "card-forge/card-art"
    }
  }
}
