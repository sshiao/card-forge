{
  "canonical": {"class_type": "LoadImage", "inputs": {"image": "canonical.png"}, "_meta": {"title": "Canonical character"}},
  "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_edit_2511_bf16.safetensors", "weight_dtype": "default"}},
  "angles": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "qwen-image-edit-2511-multiple-angles-lora.safetensors", "strength_model": 0.9}, "_meta": {"title": "Multiple angles LoRA"}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}},
  "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["angles", 0], "shift": 3.1}},
  "cfg_norm": {"class_type": "CFGNorm", "inputs": {"model": ["shift", 0], "strength": 1}},
  "lightning": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["cfg_norm", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1}},
  "scaled": {"class_type": "FluxKontextImageScale", "inputs": {"image": ["canonical", 0]}},
  "encoded": {"class_type": "VAEEncode", "inputs": {"pixels": ["scaled", 0], "vae": ["vae", 0]}},
  "negative_text": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["scaled", 0], "prompt": ""}},
  "negative": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["negative_text", 0], "reference_latents_method": "index_timestep_zero"}},
  "three_quarter_text": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["scaled", 0], "prompt": "<sks> front-right quarter view eye-level shot medium shot"}, "_meta": {"title": "Three-quarter view prompt"}},
  "three_quarter_positive": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["three_quarter_text", 0], "reference_latents_method": "index_timestep_zero"}},
  "three_quarter_sampler": {"class_type": "KSampler", "inputs": {"model": ["lightning", 0], "seed": 11, "steps": 4, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "positive": ["three_quarter_positive", 0], "negative": ["negative", 0], "latent_image": ["encoded", 0], "denoise": 1}},
  "three_quarter_decode": {"class_type": "VAEDecode", "inputs": {"samples": ["three_quarter_sampler", 0], "vae": ["vae", 0]}},
  "three_quarter": {"class_type": "SaveImage", "inputs": {"images": ["three_quarter_decode", 0], "filename_prefix": "character-forge/three_quarter"}, "_meta": {"title": "Save three-quarter view"}},
  "side_text": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["scaled", 0], "prompt": "<sks> right side view eye-level shot medium shot"}, "_meta": {"title": "Side view prompt"}},
  "side_positive": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["side_text", 0], "reference_latents_method": "index_timestep_zero"}},
  "side_sampler": {"class_type": "KSampler", "inputs": {"model": ["lightning", 0], "seed": 12, "steps": 4, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "positive": ["side_positive", 0], "negative": ["negative", 0], "latent_image": ["encoded", 0], "denoise": 1}},
  "side_decode": {"class_type": "VAEDecode", "inputs": {"samples": ["side_sampler", 0], "vae": ["vae", 0]}},
  "side": {"class_type": "SaveImage", "inputs": {"images": ["side_decode", 0], "filename_prefix": "character-forge/side"}, "_meta": {"title": "Save side view"}},
  "back_text": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "image1": ["scaled", 0], "prompt": "<sks> back view eye-level shot medium shot"}, "_meta": {"title": "Back view prompt"}},
  "back_positive": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["back_text", 0], "reference_latents_method": "index_timestep_zero"}},
  "back_sampler": {"class_type": "KSampler", "inputs": {"model": ["lightning", 0], "seed": 13, "steps": 4, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "positive": ["back_positive", 0], "negative": ["negative", 0], "latent_image": ["encoded", 0], "denoise": 1}},
  "back_decode": {"class_type": "VAEDecode", "inputs": {"samples": ["back_sampler", 0], "vae": ["vae", 0]}},
  "back": {"class_type": "SaveImage", "inputs": {"images": ["back_decode", 0], "filename_prefix": "character-forge/back"}, "_meta": {"title": "Save back view"}}
}
