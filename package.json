{
  "name": "character-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Character Forge 3D: turn one portrait into a character sheet and a textured 3D model you can rotate. Open weights only, built on ComfyUI.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "forge": "node --env-file=.env.local scripts/forge.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts && tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "license": "MIT",
  "dependencies": {
    "@comfyorg/sdk": "0.5.0",
    "@playcanvas/splat-transform": "3.10.3",
    "@sparkjsdev/spark": "2.4.0",
    "fflate": "^0.8.2",
    "ffmpeg-static": "5.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
