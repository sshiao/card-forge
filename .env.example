# Your Comfy API key, from https://platform.comfy.org/profile/api-keys
# The workspace that owns the key needs a paid Comfy Cloud plan. The Free tier has no API access.
COMFY_API_KEY=

# Optional. Leave this blank to run the workflows on Comfy Cloud.
# Set it to a Comfy Developer Platform deployment URL or a self-hosted ComfyUI to run them there instead.
COMFY_BASE_URL=

# Optional. Set to 1 to run the whole app with built-in sample outputs: no Comfy calls and no credits.
FORGE_MOCK=

# Dedicated ModelSheetTo3D deployment on the same Comfy account.
# Qwen and TRELLIS.2 keep using COMFY_BASE_URL (Cloud by default).
MODELSHEET_COMFY_URL=

